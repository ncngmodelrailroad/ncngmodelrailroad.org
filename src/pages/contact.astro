---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCard from '../components/ContactCard.astro';
import { organization } from '../config/organization';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Contact Us | N.C.N.G. Model Railroad" description="Contact the volunteers about announced layout openings, volunteering, or the model railroad. Find directions to the Nevada County Fairgrounds." image="/images/building-exterior-visit.jpg" heroImage={`${base}/images/building-exterior-visit.jpg`}>
  <section class="relative py-12 md:py-16 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img 
        src={`${base}/images/building-exterior-visit.jpg`}
        alt="N.C.N.G. Historical Model Railroad building at Nevada County Fairgrounds" 
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width={800}
        height={600}
      />
      <div class="absolute inset-0 bg-gray-900/65"></div>
    </div>
    <div class="page-container max-w-3xl relative z-10">
      <h1 class="text-4xl md:text-5xl font-bold">Contact Us</h1>
    </div>
  </section>

  <section class="py-10 md:py-12 bg-white">
    <div class="page-container max-w-3xl">
      <ContactCard
        heading="Email the volunteers"
        intro="Email is the surest way to reach our volunteers. Replies can take a few days."
        subject="Message from the N.C.N.G. website"
        cta="Write an email"
        variant="plain"
        showDetails={false}
      />
      <p class="text-sm text-gray-600 mt-3">
        Or write to
        <a href={`mailto:${organization.contact.email}`} class="text-primary underline font-semibold">{organization.contact.email}</a>.
      </p>
      <div class="flex flex-wrap gap-x-6 text-sm mt-2">
        <a href={organization.contact.phoneHref} class="inline-flex items-center min-h-11 text-primary underline">
          Phone: {organization.contact.phone}
        </a>
        <a href={organization.social.facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 text-primary underline">
          Message us on Facebook
        </a>
      </div>

      <section class="mt-8" aria-labelledby="visit-title">
        <h2 id="visit-title" class="text-2xl font-bold mb-3">Visit the layout</h2>
        <p class="text-gray-600">{organization.visiting.publicAccess}</p>
        <a href={`${base}/events`} class="inline-flex items-center min-h-11 text-primary underline font-semibold">
          See announced openings
        </a>

        <div class="grid sm:grid-cols-2 gap-6 mt-5">
          <div>
            <h3 class="font-bold mb-2">Fairgrounds address</h3>
            <address class="text-gray-700 not-italic">
              {organization.location.venue}<br />
              {organization.location.streetAddress}<br />
              {organization.location.city}, {organization.location.state} {organization.location.zip}
            </address>
          </div>
          <div>
            <h3 class="font-bold mb-2">Mailing address</h3>
            <address class="text-gray-700 not-italic">
              {organization.location.poBox}<br />
              {organization.location.poCity}, {organization.location.poState} {organization.location.poZip}
            </address>
          </div>
        </div>

        <div class="mt-5">
          <a href={organization.location.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 text-primary underline font-semibold">
            Directions to the fairgrounds
          </a>
          <iframe
            src={organization.location.mapsEmbedUrl}
            width="100%"
            height="320"
            class="rounded-lg"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Nevada County Fairgrounds location map"
          ></iframe>
        </div>

        <p class="text-sm text-gray-600 mt-4">
          This map shows the fairgrounds, not a confirmed event entrance.
          Check the opening announcement for entry, parking, and layout hours;
          gates and hours vary by event.
        </p>

        <div class="mt-8">
          <h3 class="font-bold mb-2">Finding the building</h3>
          <figure>
            <a href={`${base}/images/fairgrounds-map-full.webp`} class="block rounded-lg overflow-hidden border border-gray-200">
              <picture>
                <source media="(max-width: 640px)" srcset={`${base}/images/fairgrounds-map-railroad.webp`} type="image/webp" width="1100" height="720" />
                <source media="(max-width: 640px)" srcset={`${base}/images/fairgrounds-map-railroad.jpg`} width="1100" height="720" />
                <source srcset={`${base}/images/fairgrounds-map-focus.webp`} type="image/webp" />
                <img
                  src={`${base}/images/fairgrounds-map-focus.jpg`}
                  width="1100"
                  height="941"
                  loading="lazy"
                  decoding="async"
                  class="w-full h-auto"
                  alt="Illustrated map, not to scale, of the fairgrounds around the model railroad. A red dashed line runs from Gate 1 to the restrooms at Main Street Center, then turns left along Main Street to the red Quonset hut. The map also marks the bottle refill just past the hut and the restricted area behind it. The image links to the full fairgrounds map."
                />
              </picture>
            </a>
            <figcaption class="text-sm text-gray-600 mt-2">
              Suggested walk from Gate 1 for most events outside the Fair. Illustrated map, not to scale.
              <a href={`${base}/images/fairgrounds-map-full.webp`} class="text-primary underline">See the whole fairgrounds</a>
              or get the
              <a href={`${base}/downloads/fairgrounds-map.pdf`} class="text-primary underline">printable map (PDF, 1 MB)</a>.
            </figcaption>
          </figure>
          <ol class="list-decimal pl-6 space-y-2 text-gray-700 mt-4">
            <li>For most events outside the Fair, enter at Gate 1 on McCourtney Road. Check your event announcement, since entrances and parking can change.</li>
            <li>From Gate 1, walk straight across the entry plaza until you reach Main Street, the main path. The restrooms at Main Street Center mark this junction.</li>
            <li>Turn left onto Main Street. The red Quonset hut is on your left, with its doors facing Main Street and the lawn. Look for NCNGRR painted in white on the red wall. If you reach the bottle refill, you have just passed the hut.</li>
          </ol>
          <figure class="mt-4 max-w-sm">
            <picture>
              <source srcset={`${base}/images/fairgrounds-hut-sign.webp`} type="image/webp" />
              <img
                src={`${base}/images/fairgrounds-hut-sign.jpg`}
                width="800"
                height="560"
                loading="lazy"
                decoding="async"
                class="w-full h-auto rounded-lg border border-gray-200"
                alt="Red board-and-batten wall of the hut with NCNGRR stenciled in white letters under a corrugated roof edge."
              />
            </picture>
            <figcaption class="text-sm text-gray-600 mt-2">Look for this sign on the Main Street side.</figcaption>
          </figure>
          <p class="text-sm text-gray-600 mt-3">
            Use the doors on the Main Street side. The area behind the hut is not open to the public. The suggested walk is not a certified accessible route.
            During the Nevada County Fair, follow the Fair's entry and parking instructions.
          </p>
        </div>

        <p class="text-gray-700 mt-4">
          Questions about the building entrance, step-free access, or viewing arrangements?
          <a href={`mailto:${organization.contact.email}?subject=Published%20event%20access%20question`} class="text-primary underline">Email us before your visit</a>
          with the event name and the access information you need.
        </p>
      </section>
    </div>
  </section>
</BaseLayout>
