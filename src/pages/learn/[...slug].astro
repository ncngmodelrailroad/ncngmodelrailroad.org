---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('learn');
  return articles.map((article) => ({
    params: { slug: article.id },
    props: { article },
  }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout
  title={`${article.data.title} | N.C.N.G. Model Railroad`}
  description={article.data.description}
>
  <article class="py-16 md:py-20">
    <div class="page-container">
      {/*
        Reading measure is calibrated, not arbitrary. max-w-xl (36rem) holds
        body copy near 70 characters per line at 18px in Libre Franklin, and
        prose scales up at 32rem rather than Tailwind's sm (40rem) because the
        column reaches its 36rem cap before 40rem, which would leave a band of
        viewports rendering 16px text at 76 to 79 characters. Measured across a
        320px to 1440px sweep: 45 to 73 characters everywhere above 344px.
        Re-measure if the body font or the prose size changes.
      */}
      <div class="mx-auto max-w-xl">
        <a
          href={`${base}/learn`}
          class="inline-flex items-center gap-1 text-primary font-semibold hover:underline"
          >&larr; Back to Learn</a
        >
        <h1 class="text-4xl md:text-5xl font-bold mt-4 mb-4 text-balance">
          {article.data.title}
        </h1>
        <p class="text-lg text-gray-600 mb-8">{article.data.description}</p>
        <div class="prose min-[32rem]:prose-lg max-w-none">
          <Content />
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
