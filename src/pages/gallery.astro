---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';
import { organization } from '../config/organization';
import { getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getCategoryKey = (category: string) => category.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

const galleryEntries = await getCollection('gallery');
const introductionPhotoIds = [
  'ncng-layout-1',
  'trestle-bridge-wide',
  'engine8-hero',
  'gallery-DSC07773',
  'gallery-img-7040',
  'historic-locomotive',
];
const introductionOrder = new Map(introductionPhotoIds.map((id, index) => [id.toLowerCase(), index]));
galleryEntries.sort((a, b) =>
  (introductionOrder.get(a.id.toLowerCase()) ?? introductionPhotoIds.length) -
  (introductionOrder.get(b.id.toLowerCase()) ?? introductionPhotoIds.length) ||
  a.id.localeCompare(b.id)
);
const areas = [...new Set(galleryEntries.map(entry => entry.data.area).filter((area): area is string => Boolean(area)))]
  .sort((a, b) => a.localeCompare(b));
const photos = galleryEntries.map(entry => ({
  src: `${base}/images/${entry.data.image}`,
  alt: entry.data.title,
  caption: entry.data.caption,
  category: entry.data.category,
  categoryKey: getCategoryKey(entry.data.category),
  area: entry.data.area,
  areaKey: entry.data.area ? String(areas.indexOf(entry.data.area)) : 'unassigned',
}));

const categoryOrder = ['Layout', 'Historic', 'Volunteer Work', 'Fairgrounds & Events'];
const categories = [
  ...categoryOrder.filter(category => photos.some(photo => photo.category === category)),
  ...[...new Set(photos.map(photo => photo.category))].filter(category => !categoryOrder.includes(category)),
];
---

<BaseLayout title="Photo Gallery - N.C.N.G. Historical Model Railroad" description="Browse historic railroad photos, layout scenes, volunteer work, and fairgrounds images from the N.C.N.G. Historical Model Railroad." image="/images/trestle-bridge-wide.jpg" heroImage={`${base}/images/ncng-layout-1.jpg`}>
  <!-- Hero Section -->
  <section class="relative py-20 md:py-28 bg-gray-900 text-white overflow-hidden">
    <div class="absolute inset-0 opacity-30">
      <img 
        src={`${base}/images/ncng-layout-1.jpg`} 
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width={550}
        height={320}
      />
    </div>
    <div class="page-container relative z-10">
      <div class="max-w-3xl">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">Photo Gallery</h1>
        <p class="text-xl text-gray-300">
          Browse historic railroad photos, layout scenes, volunteer work, and fairgrounds views.
        </p>
      </div>
    </div>
  </section>

  <!-- Category Filter -->
  <section class="py-6 bg-white border-b sticky top-20 md:top-16 z-30">
    <div class="page-container">
        <div class="flex flex-wrap gap-3 justify-center">
          <button type="button" class="category-btn active" data-category="all" aria-pressed="true">All Photos</button>
          {categories.map(cat => (
          <button type="button" class="category-btn" data-category={getCategoryKey(cat)} aria-pressed="false">{cat}</button>
          ))}
        </div>
        <div id="area-filter" class:list={['mt-4 flex flex-wrap items-center justify-center gap-3', { hidden: areas.length === 0 }]}>
          <label for="gallery-area" class="text-sm font-semibold">Layout area</label>
          <select id="gallery-area" class="gallery-area">
            <option value="all">All areas</option>
            {areas.map((area, index) => <option value={String(index)}>{area}</option>)}
            <option value="unassigned">No area assigned</option>
          </select>
        </div>
      </div>
  </section>

  <!-- Photo Grid -->
  <section class="py-12 bg-gray-50">
    <div class="page-container">
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <p id="photo-count" class="text-sm text-gray-600" role="status" aria-live="polite" aria-atomic="true">{photos.length} photos</p>
        <button id="reset-gallery-filters" type="button" class="hidden text-primary underline font-semibold min-h-11">Reset filters</button>
      </div>
      <p id="gallery-empty" class="hidden py-8 text-gray-600">No photos match this category and area. Reset the filters to see all photos.</p>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6" id="photo-grid">
        {photos.map((photo, index) => (
          <article 
            class="photo-card group cursor-pointer" 
            data-category={photo.categoryKey}
            data-area={photo.areaKey}
            data-index={index}
            tabindex="0"
            role="button"
            aria-label={`View photo: ${photo.alt}`}
          >
            <div class="relative aspect-[4/3] overflow-hidden rounded-xl shadow-lg">
              <img 
                src={photo.src} 
                alt={photo.alt}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                loading="lazy"
                decoding="async"
                width={600}
                height={450}
              />
              <span class="photo-card-zoom absolute top-3 right-3 w-10 h-10 bg-white/90 rounded-full flex items-center justify-center" aria-hidden="true">
                <Icon name="solar:magnifer-bold" class="w-5 h-5 text-gray-700" />
              </span>
            </div>
            <div class="px-1 pt-3 pb-4">
              <span class="photo-category text-primary text-sm font-semibold">{photo.category}</span>
              {photo.area && <span class="photo-area block text-sm text-gray-600">{photo.area}</span>}
              <p class="text-gray-700 text-sm mt-1">{photo.caption}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Add Photos CTA -->
  <section class="py-16 bg-white">
    <div class="page-container">
      <div class="max-w-2xl mx-auto text-center">
        <h2 class="text-2xl md:text-3xl font-bold mb-4">Have Photos to Share?</h2>
        <p class="text-gray-600 mb-6">
          If you have N.C.N.G. photos, layout images, or fairgrounds shots to share, send us a note.
        </p>
        <a href={`mailto:${organization.contact.email}`} class="btn-primary">
          Contact Us
        </a>
      </div>
    </div>
  </section>

  <!-- Lightbox Modal -->
  <div id="lightbox" class="fixed inset-0 z-50 hidden bg-black/95 items-center justify-center" role="dialog" aria-modal="true" aria-label="Photo lightbox">
    <button id="lightbox-close" class="absolute top-4 right-4 text-white p-2 hover:bg-white/10 rounded-lg z-10" aria-label="Close lightbox">
      <Icon name="solar:close-square-bold" class="w-8 h-8" />
    </button>
    <button id="lightbox-prev" class="absolute left-4 top-1/2 -translate-y-1/2 text-white p-2 hover:bg-white/10 rounded-lg z-10" aria-label="Previous photo">
      <Icon name="solar:alt-arrow-left-bold" class="w-8 h-8" />
    </button>
    <button id="lightbox-next" class="absolute right-4 top-1/2 -translate-y-1/2 text-white p-2 hover:bg-white/10 rounded-lg z-10" aria-label="Next photo">
      <Icon name="solar:alt-arrow-right-bold" class="w-8 h-8" />
    </button>
    <div class="flex flex-col items-center max-w-5xl w-full px-4">
      <!-- Seeded with the first photo so the markup never ships an empty src.
           openLightbox() overwrites both attributes before the dialog is shown,
           and the URL matches a grid image, so this costs no extra request. -->
      <img
        id="lightbox-img"
        src={photos[0]?.src}
        alt={photos[0]?.alt}
        class="max-h-[80vh] max-w-full object-contain"
      />
      <p id="lightbox-caption" class="text-white text-center mt-4 max-w-2xl"></p>
    </div>
  </div>
</BaseLayout>

<style>
  .gallery-area {
    max-width: 100%;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-text);
    font: inherit;
  }

  .category-btn {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.875rem;
    transition: all 0.2s;
  }
  .category-btn:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }
  .category-btn.active {
    background-color: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }
  @media (prefers-color-scheme: dark) {
    /* Hover text needs the lighter red on the dark page background, except the
       active pill, which has a red background and keeps white text. */
    .category-btn:not(.active):hover {
      color: var(--color-primary-light);
    }
    .category-btn.active:hover {
      color: white;
    }
  }
  .photo-card.hidden {
    display: none;
  }
  .photo-card {
    border-radius: 0.75rem;
  }
  .photo-card:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* Captions stay visible; hover only enhances the zoom affordance. */
  .photo-card-zoom {
    transition: opacity 0.3s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .photo-card-zoom {
      opacity: 0;
    }

    .photo-card:hover .photo-card-zoom,
    .photo-card:focus-visible .photo-card-zoom {
      opacity: 1;
    }
  }

  /* Skip rendering off-screen gallery items until scrolled into view */
  .photo-card:nth-child(n+7) {
    content-visibility: auto;
    contain-intrinsic-size: auto 300px;
  }
</style>

<script>
  const categoryBtns = document.querySelectorAll<HTMLButtonElement>('.category-btn');
  const photoCards = document.querySelectorAll<HTMLElement>('.photo-card');
  const areaSelect = document.querySelector<HTMLSelectElement>('#gallery-area');
  const resetFilters = document.getElementById('reset-gallery-filters');
  const photoCount = document.getElementById('photo-count');
  const emptyGallery = document.getElementById('gallery-empty');
  let selectedCategory: string | null = 'all';

  function filterPhotos() {
    const area = areaSelect?.value ?? 'all';
    let count = 0;
    categoryBtns.forEach(button => {
      const selected = button.getAttribute('data-category') === selectedCategory;
      button.classList.toggle('active', selected);
      button.setAttribute('aria-pressed', String(selected));
    });
    photoCards.forEach(card => {
      const visible = (selectedCategory === 'all' || card.dataset.category === selectedCategory) &&
        (area === 'all' || card.dataset.area === area);
      card.classList.toggle('hidden', !visible);
      if (visible) count += 1;
    });
    if (photoCount) photoCount.textContent = `${count} ${count === 1 ? 'photo' : 'photos'}`;
    emptyGallery?.classList.toggle('hidden', count !== 0);
    resetFilters?.classList.toggle('hidden', selectedCategory === 'all' && area === 'all');
  }

  categoryBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      selectedCategory = btn.getAttribute('data-category');
      filterPhotos();
    });
  });
  areaSelect?.addEventListener('change', filterPhotos);
  resetFilters?.addEventListener('click', () => {
    selectedCategory = 'all';
    if (areaSelect) areaSelect.value = 'all';
    filterPhotos();
    categoryBtns[0]?.focus();
  });

  // Lightbox functionality
  const lightbox = document.getElementById('lightbox');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxClose = document.getElementById('lightbox-close');
  const lightboxPrev = document.getElementById('lightbox-prev');
  const lightboxNext = document.getElementById('lightbox-next');
  
  let currentIndex = 0;
  const photos = Array.from(photoCards);

  let triggerElement: HTMLElement | null = null;

  function openLightbox(index: number) {
    currentIndex = index;
    const card = photos[index];
    const img = card.querySelector('img') as HTMLImageElement;
    const caption = [
      card.querySelector('.photo-category')?.textContent,
      card.querySelector('.photo-area')?.textContent,
      card.querySelector('p')?.textContent,
    ].filter(Boolean).join(' · ');

    // Only capture the return target when opening from the grid. nextPhoto and
    // prevPhoto route back through here, and at that point the active element
    // is one of the lightbox's own buttons, which is about to be hidden.
    if (lightbox?.classList.contains('hidden')) {
      triggerElement = document.activeElement as HTMLElement;
    }

    lightboxImg.src = img.src;
    lightboxImg.alt = img.alt;
    if (lightboxCaption) lightboxCaption.textContent = caption;
    
    lightbox?.classList.remove('hidden');
    lightbox?.classList.add('flex');
    document.body.style.overflow = 'hidden';
    lightboxClose?.focus();
  }

  function closeLightbox() {
    lightbox?.classList.add('hidden');
    lightbox?.classList.remove('flex');
    document.body.style.overflow = '';
    triggerElement?.focus();
    triggerElement = null;
  }

  function nextPhoto() {
    const visiblePhotos = photos.filter(p => !p.classList.contains('hidden'));
    const currentVisible = visiblePhotos.indexOf(photos[currentIndex]);
    const nextVisible = (currentVisible + 1) % visiblePhotos.length;
    currentIndex = photos.indexOf(visiblePhotos[nextVisible]);
    openLightbox(currentIndex);
  }

  function prevPhoto() {
    const visiblePhotos = photos.filter(p => !p.classList.contains('hidden'));
    const currentVisible = visiblePhotos.indexOf(photos[currentIndex]);
    const prevVisible = (currentVisible - 1 + visiblePhotos.length) % visiblePhotos.length;
    currentIndex = photos.indexOf(visiblePhotos[prevVisible]);
    openLightbox(currentIndex);
  }

  photoCards.forEach((card, index) => {
    card.addEventListener('click', () => openLightbox(index));
    card.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openLightbox(index);
      }
    });
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxNext?.addEventListener('click', nextPhoto);
  lightboxPrev?.addEventListener('click', prevPhoto);

  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });

  document.addEventListener('keydown', (e) => {
    if (!lightbox?.classList.contains('hidden')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') nextPhoto();
      if (e.key === 'ArrowLeft') prevPhoto();
      // Trap focus within lightbox
      if (e.key === 'Tab') {
        const focusable = lightbox.querySelectorAll<HTMLElement>('button');
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }
  });
</script>
