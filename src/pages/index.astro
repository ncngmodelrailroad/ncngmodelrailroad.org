---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { Icon } from 'astro-icon/components';
import { organization } from '../config/organization';
import { getCollection } from 'astro:content';
import { formatEventDate, getEventDisplayDates, isUpcomingEvent } from '../utils/events';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const now = new Date();
const upcomingEvents = (await getCollection('events'))
  .filter(event => isUpcomingEvent(event.data, now))
  .sort((a, b) => getEventDisplayDates(a.data).date.getTime() - getEventDisplayDates(b.data).date.getTime())
  .slice(0, 2);
const [nextEvent, followingEvent] = upcomingEvents;
const nextDates = nextEvent && getEventDisplayDates(nextEvent.data);
const followingDates = followingEvent && getEventDisplayDates(followingEvent.data);
---

<BaseLayout title="Nevada County Narrow Gauge Historical Model Railroad" description="Discover upcoming events, miniature trains, and local railroad history at the Nevada County Fairgrounds. Find event details for the N.C.N.G. Historical Model Railroad." image="/images/engine8-hero.jpg" heroImage={`${base}/images/engine8-hero.jpg`}>
  <section class="relative text-white overflow-hidden" aria-labelledby="hero-title">
    <div class="absolute inset-0 z-0">
      <img 
        src={`${base}/images/engine8-hero.jpg`} 
        alt="Engine #8 approaching on the model railroad tracks with switches and scenery" 
        class="w-full h-full object-cover animate-kenburns"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width={1200}
        height={675}
      />
      <div class="absolute inset-0 hero-vignette"></div>
    </div>
    <div class="page-container relative z-10 py-8 md:py-16">
      <div class="max-w-3xl">
        <h1 id="hero-title" class="text-xl md:text-2xl font-body font-bold text-white">
          Nevada County Narrow Gauge
          <span class="block text-base md:text-lg font-medium mt-1">Historical Model Railroad</span>
        </h1>
        {nextEvent && nextDates ? (
          <>
            <div class="mt-8 md:mt-10">
              <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-4">
                Next up: {nextEvent.data.title}
              </h2>
              <p class="text-xl md:text-2xl font-semibold text-white mb-1">
                {formatEventDate(nextDates.date, nextDates.endDate, 'compact')}
              </p>
              <p class="hero-copy text-sm mb-5">{nextDates.label}</p>
              <Button href={`${base}/events#event-${nextEvent.id}`} size="lg">Event Details</Button>
              <p class="hero-copy text-sm mt-3">
                {nextEvent.data.layoutStartDate
                  ? "See event details for layout hours."
                  : "See event details for the layout's opening dates and hours."}
              </p>
            </div>
            <div class="mt-8 pt-6 border-t border-white/30">
              {followingEvent && followingDates && (
                <div class="mb-3">
                  <h2 class="text-xl md:text-2xl font-body font-bold text-white">
                    <a href={`${base}/events#event-${followingEvent.id}`} class="inline-flex items-center min-h-11 underline underline-offset-4">
                      Then: {followingEvent.data.title}
                    </a>
                  </h2>
                  <p class="hero-copy mt-1">
                    {followingDates.label}: {formatEventDate(followingDates.date, followingDates.endDate, 'compact')}
                  </p>
                </div>
              )}
              <a href={`${base}/events`} class="inline-flex items-center min-h-11 font-semibold text-white underline underline-offset-4">
                All Upcoming Events
              </a>
            </div>
          </>
        ) : (
          <div class="mt-8">
            <h2 class="text-4xl md:text-5xl font-bold text-white mb-4">Explore the Model Railroad</h2>
            <p class="hero-copy text-lg max-w-xl mb-6">
              Explore the trains, towns, and landscapes of our volunteer-built model railroad.
            </p>
            <Button href={`${base}/gallery`} size="lg">Explore the Layout Photos</Button>
            <p class="hero-copy mt-6">Our next event will appear here when it's announced.</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-white">
    <div class="page-container">
      <div class="grid lg:grid-cols-5 gap-8 md:gap-12 items-center">
        <div class="lg:col-span-3">
          <h2 class="text-3xl md:text-4xl font-bold mb-6 leading-tight">
            Local History in Miniature
          </h2>
          <p class="text-lg text-gray-600 mb-6 leading-relaxed">
            Volunteers have built and maintained the layout since {organization.founded}.
            It recreates the railroad that served Nevada County from
            {organization.prototype.serviceStart} to {organization.prototype.serviceEnd}.
            Follow trains through miniature Nevada City, Grass Valley, Chicago Park,
            and Colfax, including the Bear River Bridge.
          </p>
          <p class="text-gray-600 mb-6 leading-relaxed">
            On-board cameras bring a train-level view of the towns, yards, and bridges
            to our Train Cam TV display.
          </p>
          <div class="flex flex-wrap gap-6">
            <a href={`${base}/gallery`} class="text-primary underline font-semibold">See Layout Photos</a>
            <a href={`${base}/about`} class="text-primary underline font-semibold">How the Layout Works</a>
            <a href={`${base}/map/`} class="text-primary underline font-semibold">Explore the Historic Map</a>
          </div>
        </div>
        <div class="lg:col-span-2">
          <figure>
            <img 
              src={`${base}/images/gallery-img_9139.jpg`}
              alt="Miniature freight cars beside a trackside building and wooded hills"
              class="rounded-xl w-full"
              loading="lazy"
              decoding="async"
              width={800}
              height={600}
            />
            <figcaption class="text-sm text-gray-600 mt-3">Trackside scenery on our model railroad.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16 bg-cream">
    <div class="page-container grid md:grid-cols-2 gap-8 md:gap-12 items-center">
      <div>
        <h2 class="text-3xl font-bold mb-4">The Railroad Building</h2>
        <p class="text-gray-600 mb-6">
          {organization.visiting.publicAccess}
        </p>
        <address class="text-gray-700 not-italic mb-6 flex items-start gap-3">
          <Icon name="solar:map-point-bold" class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" />
          <span>
            {organization.location.venue}<br />
            {organization.location.streetAddress}<br />
            {organization.location.city}, {organization.location.state}
          </span>
        </address>
        <a href={organization.location.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 text-primary underline font-semibold">
          Directions to the Fairgrounds
        </a>
      </div>
      <img
        src={`${base}/images/building-exterior-visit.jpg`}
        alt="The model railroad building and railroad crossing sign at the Nevada County Fairgrounds"
        class="rounded-xl w-full"
        loading="lazy"
        decoding="async"
        width={800}
        height={600}
      />
    </div>
  </section>

  <section class="py-10 md:py-12 bg-white" aria-labelledby="support-title">
    <div class="page-container max-w-3xl">
      <h2 id="support-title" class="text-3xl font-bold mb-3">Help keep the layout running</h2>
      <p class="text-gray-600 mb-5">
        Volunteer time and donations support the trains, scenery, and building.
      </p>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
        <a href={`${base}/donate`} class="btn-primary">Support the layout</a>
        <a href={`${base}/volunteer`} class="inline-flex items-center min-h-11 text-primary underline font-semibold">
          Volunteer with us
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
