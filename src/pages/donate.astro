---
import BaseLayout from '../layouts/BaseLayout.astro';
import { donationEmailHref, organization } from '../config/organization';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="Support the Layout | N.C.N.G. Model Railroad" description="Support the N.C.N.G. Historical Model Railroad with volunteer time, donated materials, or financial contributions.">
  <section class="py-10 md:py-12 bg-primary text-white">
    <div class="page-container max-w-3xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Support the Layout</h1>
      <p class="text-lg text-white/90">
        Help keep the trains running and share local railroad history.
      </p>
    </div>
  </section>

  <section class="py-10 md:py-12 bg-white">
    <div class="page-container max-w-3xl">
      <section aria-labelledby="monetary-donations-title">
        <h2 id="monetary-donations-title" class="text-3xl font-bold mb-3">Make a donation</h2>
        <p class="text-gray-700 mb-3">
          Your support helps with maintenance, scenery, electrical work, rolling stock,
          building upkeep, and visitor education.
        </p>
        <p class="text-gray-700 mb-4">
          {organization.donations.instructions}
        </p>
        <a href={donationEmailHref} class="btn-primary">Email about a donation</a>
        <p class="text-sm text-gray-600 mt-3">
          Or write to
          <a href={donationEmailHref} class="text-primary underline font-semibold">{organization.contact.email}</a>.
        </p>
        <aside id="nonprofit-details" aria-label="Nonprofit details" class="mt-6 border-t border-gray-200 pt-5 scroll-mt-28 text-sm text-gray-700">
          <p class="font-semibold text-gray-900">
            All-volunteer {organization.nonprofit.classification} nonprofit.
            <span class="whitespace-nowrap">EIN: {organization.nonprofit.ein}.</span>
          </p>
          <p class="mt-1">IRS-listed name: {organization.nonprofit.irsName}.</p>
          <p class="mt-1">{organization.nonprofit.deductibilityStatement}</p>
          <a
            href={organization.nonprofit.sourceUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center min-h-11 text-primary underline font-semibold"
          >
            About the IRS data source
          </a>
        </aside>
      </section>

      <section class="mt-10" aria-labelledby="other-support-title">
        <h2 id="other-support-title" class="text-2xl font-bold mb-5">Other ways to help</h2>
        <div>
          <h3 class="text-lg font-bold mb-2">Volunteer</h3>
          <p class="text-gray-600">
            Run trains, build scenery, maintain equipment, or welcome visitors.
            No model railroad experience needed.
          </p>
          <a href={`${base}/volunteer`} class="inline-flex items-center min-h-11 text-primary underline font-semibold">
            Learn about volunteering
          </a>
        </div>

        <div class="mt-6">
          <h3 class="text-lg font-bold mb-2">Offer equipment or materials</h3>
          <p class="text-gray-600">
            We work with
            <a href={`${base}/learn/glossary#on3`} class="text-primary underline">On3 scale</a>,
            <a href={`${base}/learn/glossary#dcc-digital-command-control`} class="text-primary underline">DCC systems</a>,
            tools, and historical railroad items.
          </p>
          <p class="text-gray-600 mt-2">
            Space is limited. Email us before dropping anything off; photos help.
          </p>
          <a href={`mailto:${organization.contact.email}`} class="inline-flex items-center min-h-11 text-primary underline font-semibold">
            Email about equipment
          </a>
        </div>
      </section>

      <p class="mt-8 border-t border-gray-200 pt-4">
        <a href={donationEmailHref} class="inline-flex items-center min-h-11 text-primary underline font-semibold">
          Email about a donation
        </a>
      </p>
    </div>
  </section>
</BaseLayout>
