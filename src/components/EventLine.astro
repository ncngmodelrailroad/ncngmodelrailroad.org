---
import type { CollectionEntry } from 'astro:content';
import { getEventDisplayDates, pacificToday } from '../utils/events';
import { computeLineView, type StopState } from '../utils/eventLine';

interface Props {
  events: CollectionEntry<'events'>[];
}

const shortDate = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const dayOf = (date: Date) => date.toISOString().split('T')[0];

const stops = Astro.props.events
  .map((event) => {
    const { date, endDate } = getEventDisplayDates(event.data);
    return {
      id: event.id,
      title: event.data.title,
      start: dayOf(date),
      end: dayOf(endDate ?? date),
      dates: shortDate.formatRange(date, endDate ?? date),
      layoutConfirmed: Boolean(event.data.layoutStartDate),
    };
  })
  .sort((a, b) => a.start.localeCompare(b.start));

// Rendered with the build date so the line works without JavaScript; the
// script below recomputes it with the visitor's date between deploys.
const view = computeLineView(stops, pacificToday());
const next = stops.find(s => s.id === view.nextId);
const current = stops.find(s => view.states[s.id] === 'now');

// Without confirmed layout dates the stop shows host event dates, so "now"
// must not read as the layout being open.
const stateLabel = (state: StopState, layoutConfirmed: boolean) =>
  state === 'now' ? (layoutConfirmed ? 'Layout open' : 'Host event on now')
    : { past: 'Departed', next: 'Next stop', later: 'Coming up' }[state];
const statusLead = (stop?: { layoutConfirmed: boolean }, isNow = false) =>
  !stop ? 'No upcoming stops posted yet.'
    : isNow ? (stop.layoutConfirmed ? 'Layout open now' : 'Host event on now')
    : 'Next stop';
---

{stops.length > 0 && (
  <nav
    class="event-line"
    aria-label="Event timeline"
    data-event-line
    style={`--count: ${view.visible.length}; --progress: ${view.progress};`}
  >
    <p class="event-line-status">
      <span data-status-countdown class="event-line-countdown"></span>
      <span data-status-lead>{statusLead(current ?? next, Boolean(current))}</span>
      <strong data-status-title>{(current ?? next)?.title}</strong>
    </p>

    <div class="event-line-rail">
      <div class="event-line-track" aria-hidden="true">
        <span class="event-line-traveled"></span>
        <span class="event-line-marker">
          <span class="event-line-marker-label">Today</span>
          <svg class="event-line-loco" viewBox="0 0 64 44" width="64" height="44">
            <g class="loco-steam" fill="#F3F4F6">
              <circle cx="46" cy="4" r="3.2" />
              <circle cx="42" cy="3" r="2.6" />
              <circle cx="38" cy="4" r="2" />
            </g>
            <path class="loco-stack" d="M41 8.5h11l-2.5 4.5h-6z" fill="#4B6584" />
            <rect x="44" y="12.5" width="5" height="5" fill="#4B6584" />
            <rect x="24" y="16" width="31" height="13" rx="6.5" fill="#4B6584" />
            <rect x="28" y="18" width="23" height="2.5" rx="1.25" fill="#7F9CB8" />
            <rect x="43" y="16" width="2" height="13" fill="#E0A526" />
            <path d="M33 16a3.5 3.5 0 0 1 7 0z" fill="#E0A526" />
            <rect x="52" y="12" width="6" height="5" rx="1.5" fill="#E0A526" />
            <circle cx="57.2" cy="14.5" r="1.6" fill="#FEF3C7" />
            <rect x="5" y="8" width="21" height="21" rx="3" fill="#C2412F" />
            <rect x="3" y="5.5" width="25" height="4" rx="2" fill="#2B3A4E" />
            <rect x="10" y="12" width="10" height="8" rx="2" fill="#FDE68A" />
            <rect x="5" y="23" width="21" height="2" fill="#9F2F22" />
            <rect x="4" y="28.5" width="54" height="4" rx="1.5" fill="#2B3A4E" />
            <path d="M56 29h4l3 9h-8z" fill="#9F2F22" />
            <g class="loco-wheel" style="transform-origin: 18px 36px">
              <circle cx="18" cy="36" r="6.5" fill="#2B3A4E" stroke="#E0A526" stroke-width="1.5" />
              <path d="M18 30.5v11M12.5 36h11" stroke="#E0A526" stroke-width="1.2" />
              <circle cx="18" cy="36" r="1.6" fill="#E0A526" />
            </g>
            <g class="loco-wheel" style="transform-origin: 33px 36px">
              <circle cx="33" cy="36" r="6.5" fill="#2B3A4E" stroke="#E0A526" stroke-width="1.5" />
              <path d="M33 30.5v11M27.5 36h11" stroke="#E0A526" stroke-width="1.2" />
              <circle cx="33" cy="36" r="1.6" fill="#E0A526" />
            </g>
            <g class="loco-wheel" style="transform-origin: 48px 38.5px">
              <circle cx="48" cy="38.5" r="4" fill="#2B3A4E" stroke="#E0A526" stroke-width="1.2" />
              <circle cx="48" cy="38.5" r="1.1" fill="#E0A526" />
            </g>
            <rect x="18" y="35.25" width="15" height="1.5" rx="0.75" fill="#E0A526" />
          </svg>
        </span>
      </div>
      <ol class="event-line-stops">
        {stops.map((stop) => {
          const state = view.states[stop.id];
          return (
            <li
              class="event-line-stop"
              data-stop-id={stop.id}
              data-start={stop.start}
              data-end={stop.end}
              data-title={stop.title}
              data-layout-confirmed={stop.layoutConfirmed ? 'true' : undefined}
              data-state={state}
              hidden={!view.visible.includes(stop.id)}
            >
              <a href={`#event-${stop.id}`}>
                <span class="event-line-dot" aria-hidden="true"></span>
                <span class="event-line-state" data-state-label>{stateLabel(state, stop.layoutConfirmed)}</span>
                <span class="event-line-title">{stop.title}</span>
                <span class="event-line-dates">
                  {stop.dates}
                  {!stop.layoutConfirmed && <span class="event-line-note">host event</span>}
                </span>
              </a>
            </li>
          );
        })}
      </ol>
    </div>
  </nav>
)}

<script>
  import { pacificToday } from '../utils/events';
  import { computeLineView, formatCountdown, type StopState } from '../utils/eventLine';

  const stateLabel = (state: StopState, layoutConfirmed: boolean) =>
    state === 'now' ? (layoutConfirmed ? 'Layout open' : 'Host event on now')
      : { past: 'Departed', next: 'Next stop', later: 'Coming up' }[state];

  for (const line of document.querySelectorAll<HTMLElement>('[data-event-line]')) {
    const items = [...line.querySelectorAll<HTMLLIElement>('[data-stop-id]')];
    const stops = items.map(li => ({ id: li.dataset.stopId!, start: li.dataset.start!, end: li.dataset.end! }));
    const view = computeLineView(stops, pacificToday());

    for (const li of items) {
      const state = view.states[li.dataset.stopId!];
      li.dataset.state = state;
      li.hidden = !view.visible.includes(li.dataset.stopId!);
      li.querySelector('[data-state-label]')!.textContent = stateLabel(state, 'layoutConfirmed' in li.dataset);
    }
    line.style.setProperty('--count', String(view.visible.length));
    line.style.setProperty('--progress', String(view.progress));

    const current = items.find(li => li.dataset.state === 'now');
    const next = items.find(li => li.dataset.stopId === view.nextId);
    const featured = current ?? next;
    const counting = !current && view.daysToNext !== undefined;
    line.querySelector('[data-status-lead]')!.textContent =
      !featured ? 'No upcoming stops posted yet.'
        : current ? ('layoutConfirmed' in current.dataset ? 'Layout open now' : 'Host event on now')
        : counting ? 'until the next stop' : 'Next stop';
    line.querySelector('[data-status-title]')!.textContent = featured?.dataset.title ?? '';
    line.querySelector('[data-status-countdown]')!.textContent = counting ? formatCountdown(view.daysToNext!) : '';
  }
</script>

<style>
  @property --progress {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .event-line {
    --axis: 0.75rem;
    --gauge: 0.875rem;
    --ahead: rgba(255, 255, 255, 0.3);
    --rail: rgba(255, 255, 255, 0.42);
    --tie: rgba(255, 255, 255, 0.16);
    --lit: var(--color-primary-light);
    --signal: #FCD34D;
    --bed: #111827;
    --muted: rgb(156 163 175);
    --marker-at: calc((var(--progress) + 0.5) / var(--count) * 100%);
    text-align: left;
    font-variant-numeric: tabular-nums;
    animation: event-line-ride 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  @media (prefers-color-scheme: dark) {
    .event-line {
      --bed: #0f0f1e;
    }
  }

  @keyframes event-line-ride {
    from { --progress: -0.5; }
  }

  .event-line-status {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.625rem;
    margin-bottom: 1.5rem;
    font-size: 1.0625rem;
    color: var(--muted);
  }

  .event-line-status strong {
    color: white;
    font-weight: 600;
  }

  .event-line-countdown {
    color: var(--signal);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1;
  }

  .event-line-countdown:empty,
  [data-status-title]:empty {
    display: none;
  }

  [data-status-title]::before {
    content: '·';
    margin-right: 0.625rem;
    color: var(--muted);
    font-weight: 400;
  }

  .event-line-rail {
    position: relative;
  }

  /* Track: two rails over crossties. The traveled stretch is the same
     track drawn in the lit color, so the ties stay aligned. */
  .event-line-track,
  .event-line-traveled {
    position: absolute;
    background:
      linear-gradient(var(--rail), var(--rail)) var(--rail-a) / var(--rail-size) no-repeat,
      linear-gradient(var(--rail), var(--rail)) var(--rail-b) / var(--rail-size) no-repeat,
      repeating-linear-gradient(var(--tie-dir), var(--tie) 0 3px, transparent 3px 11px);
  }

  .event-line-traveled {
    --rail: var(--lit);
    --tie: color-mix(in srgb, var(--lit) 40%, transparent);
  }

  /* A zero-size anchor on the track; the loco and label hang off it. */
  .event-line-marker {
    position: absolute;
    z-index: 2;
    width: 0;
    height: 0;
  }

  .event-line-loco {
    position: absolute;
    width: 84px;
    height: auto;
    left: -42px;
    bottom: -3px;
    overflow: visible;
    filter: drop-shadow(0 3px 4px rgba(0, 0, 0, 0.45));
  }

  .event-line-marker-label {
    position: absolute;
    bottom: 60px;
    left: 0;
    transform: translateX(-50%);
    padding: 0.0625rem 0.5rem;
    border-radius: 999px;
    background: var(--signal);
    color: #1F2937;
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.4;
    white-space: nowrap;
  }

  /* Wheels turn and the stack puffs while the train rolls in. */
  .loco-wheel {
    animation: loco-wheel 1.6s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
  }

  @keyframes loco-wheel {
    from { transform: rotate(-720deg); }
  }

  .loco-steam circle {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    animation: loco-puff 1.2s ease-out 3 both;
  }

  .loco-steam circle:nth-child(2) { animation-delay: 0.3s; }
  .loco-steam circle:nth-child(3) { animation-delay: 0.6s; }

  @keyframes loco-puff {
    0% { opacity: 0; transform: translate(0, 4px) scale(0.4); }
    30% { opacity: 0.85; }
    100% { opacity: 0; transform: translate(-6px, -6px) scale(1.3); }
  }

  .event-line-stops {
    display: grid;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .event-line-stop a {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    border-radius: 0.375rem;
    color: inherit;
    text-decoration: none;
  }

  .event-line-dot {
    position: absolute;
    z-index: 1;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: var(--bed);
    box-shadow: inset 0 0 0 2px var(--ahead);
    transform: translate(-50%, -50%);
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .event-line-state {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--signal);
  }

  .event-line-title {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.3;
    color: rgb(229 231 235);
    text-wrap: balance;
  }

  .event-line-dates {
    font-size: 0.8125rem;
    color: var(--muted);
  }

  .event-line-note {
    display: none;
  }

  .event-line-stop a:hover .event-line-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  .event-line-stop a:hover .event-line-dot {
    transform: translate(-50%, -50%) scale(1.4);
  }

  .event-line-stop a:focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 6px;
  }

  /* Only the stop that matters now gets a visible label; the rest keep it for screen readers. */
  [data-state='past'] .event-line-state,
  [data-state='later'] .event-line-state {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  [data-state='past'] .event-line-dot {
    background: var(--lit);
    box-shadow: 0 0 0 3px var(--bed);
  }

  [data-state='past'] .event-line-title {
    color: var(--muted);
  }

  [data-state='now'] .event-line-dot,
  [data-state='next'] .event-line-dot {
    width: 0.875rem;
    height: 0.875rem;
    box-shadow: inset 0 0 0 3px var(--signal);
  }

  [data-state='now'] .event-line-title,
  [data-state='next'] .event-line-title {
    color: white;
    font-weight: 600;
  }

  [data-state='now'] .event-line-note,
  [data-state='next'] .event-line-note {
    display: inline;
  }

  .event-line-note::before {
    content: ' · ';
  }

  /* Phones: the line runs down the page. */
  @media (max-width: 47.999rem) {
    [data-status-title] {
      flex-basis: 100%;
    }

    [data-status-title]::before {
      content: none;
    }

    .event-line {
      --axis: 1.75rem;
    }

    .event-line-stops {
      grid-auto-rows: 1fr;
    }

    .event-line-stop a {
      justify-content: center;
      min-height: 4.5rem;
      padding: 0.5rem 0 0.5rem 4rem;
    }

    .event-line-dot {
      left: var(--axis);
      top: 50%;
    }

    .event-line {
      --tie-dir: 180deg;
      --rail-size: 2px 100%;
      --rail-a: 3px 0;
      --rail-b: calc(100% - 3px) 0;
    }

    .event-line-track {
      top: 0;
      bottom: 0;
      left: calc(var(--axis) - var(--gauge) / 2);
      width: var(--gauge);
    }

    .event-line-traveled {
      inset: 0 0 auto;
      height: var(--marker-at);
    }

    .event-line-marker {
      left: 50%;
      top: var(--marker-at);
    }

    /* Upright and centered on the track, like a token on a route map. */
    .event-line-loco {
      width: 60px;
      left: -30px;
      bottom: auto;
      top: -21px;
    }

    .event-line-marker-label {
      display: none;
    }
  }

  /* Tablets and up: the line runs across, stations evenly spaced like a route map. */
  @media (min-width: 48rem) {
    .event-line-status {
      justify-content: center;
      margin-bottom: 5.75rem;
    }

    .event-line-stops {
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, 1fr);
    }

    .event-line-stop a {
      align-items: center;
      text-align: center;
      padding: 1.75rem 0.75rem 0.25rem;
    }

    .event-line-dot {
      left: 50%;
      top: var(--axis);
    }

    .event-line {
      --tie-dir: 90deg;
      --rail-size: 100% 2px;
      --rail-a: 0 3px;
      --rail-b: 0 calc(100% - 3px);
    }

    .event-line-track {
      top: calc(var(--axis) - var(--gauge) / 2);
      left: 0;
      right: 0;
      height: var(--gauge);
    }

    .event-line-traveled {
      inset: 0 auto 0 0;
      width: var(--marker-at);
    }

    .event-line-marker {
      top: 50%;
      left: var(--marker-at);
    }
  }
</style>
