---
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  heroImage?: string;
  noindex?: boolean;
}

const { 
  title, 
  description = "An On3 scale historical model railroad display dedicated to the memory of the Nevada County Narrow Gauge Railroad. Located at Nevada County Fairgrounds, Grass Valley, CA.",
  image = "/images/engine8-hero.jpg",
  type = "website",
  heroImage,
  noindex = false
} = Astro.props;

import { Icon } from 'astro-icon/components';
import { organization } from '../config/organization';
import { contentUse } from '../config/contentUse';
import { contentFeeds, dataCatalogPath } from '../config/data';

// Self-hosted fonts (no third-party CDN, no visitor IP sent to Google).
import '@fontsource/archivo-black';
import '@fontsource-variable/libre-franklin';
import archivoBlackUrl from '@fontsource/archivo-black/files/archivo-black-latin-400-normal.woff2?url';
import libreFranklinUrl from '@fontsource-variable/libre-franklin/files/libre-franklin-latin-wght-normal.woff2?url';
import { navItems } from '../config/navigation';
import { getPublicImageSize } from '../utils/imageSize';

// Preview cards are sized from the declared dimensions before the image loads,
// so read them from the file instead of asserting a fixed 1200x630. A portrait
// or near-square photo is served as a small `summary` card, where it is shown
// as a square thumbnail, rather than being cropped to a wide banner.
const socialImageSize = getPublicImageSize(image);
const socialImageRatio = socialImageSize ? socialImageSize.width / socialImageSize.height : 0;
const twitterCard = socialImageRatio >= 1.5 ? 'summary_large_image' : 'summary';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';

function navCurrent(href?: string): 'page' | 'location' | undefined {
  if (!href) return undefined;
  const path = `${base}${href}`.replace(/\/$/, '') || '/';
  if (currentPath === path) return 'page';
  return path !== '/' && currentPath.startsWith(`${path}/`) ? 'location' : undefined;
}

const pageFeed = Object.values(contentFeeds).find(
  (feed) => `${base}${feed.page}` === Astro.url.pathname.replace(/\/$/, ''),
);

const siteUrl = `${Astro.site?.origin || 'https://ncngmodelrailroad.org'}${base}`;
const socialProfiles = Object.values(organization.social).filter(Boolean);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site || 'https://ncngmodelrailroad.org');

// Structured data for nonprofit organization (Schema.org)
const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": organization.fullName,
  "alternateName": [organization.name, organization.nonprofit.irsName],
  "url": siteUrl,
  "logo": `${siteUrl}/images/hero-logo.png`,
  "description": description,
  "foundingDate": String(organization.founded),
  "address": {
    "@type": "PostalAddress",
    "streetAddress": organization.location.streetAddress,
    "addressLocality": organization.location.city,
    "addressRegion": organization.location.state,
    "postalCode": organization.location.zip,
    "addressCountry": "US"
  },
  "areaServed": "Nevada County, California",
  "nonprofitStatus": organization.nonprofit.schemaStatus,
  "taxID": organization.nonprofit.ein,
  "sameAs": socialProfiles,
  "telephone": organization.contact.phone,
  "email": organization.contact.email,
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": organization.contact.phone,
    "contactType": "customer service",
    "areaServed": "Nevada County, CA"
  },
};

// Structured data for local business / museum (Schema.org)
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "Museum",
  "name": organization.name,
  "description": `A historically accurate On3 scale model of the Nevada County Narrow Gauge Railroad, operated by volunteers since ${organization.founded}.`,
  "url": siteUrl,
  "telephone": organization.contact.phone,
  "email": organization.contact.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": organization.location.streetAddress,
    "addressLocality": organization.location.city,
    "addressRegion": organization.location.state,
    "postalCode": organization.location.zip,
    "addressCountry": "US"
  },
  "hasMap": organization.location.mapsUrl,
  "sameAs": socialProfiles,
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "description": organization.visiting.publicAccess
  },
};

// Breadcrumb structured data
const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Home",
      "item": siteUrl
    },
    ...pathSegments.map((segment, index) => ({
      "@type": "ListItem",
      "position": index + 2,
      "name": segment.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' '),
      "item": `${siteUrl}/${segment}`
    }))
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="preload" href={archivoBlackUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={libreFranklinUrl} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta name="description" content={description} />
    <meta name="author" content={organization.fullName} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="theme-color" content="#8A1F17" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1a2e" media="(prefers-color-scheme: dark)" />
    
    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="describedby" type="text/plain" href={`${base}/llms.txt`} />
    <link rel="describedby" type="application/json" href={`${base}${dataCatalogPath}`} title="Public data catalog" />
    {pageFeed && (
      <link rel="alternate" type="application/json" href={`${base}${pageFeed.path}`} title={pageFeed.name} />
    )}
    
    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    {socialImageSize && (
      <>
        <meta property="og:image:width" content={String(socialImageSize.width)} />
        <meta property="og:image:height" content={String(socialImageSize.height)} />
        <meta property="og:image:type" content={`image/${socialImageSize.type}`} />
      </>
    )}
    <meta property="og:image:alt" content={title} />
    <meta property="og:site_name" content={organization.name} />
    <meta property="og:locale" content="en_US" />
    
    <!-- Twitter/X Card (for link previews, no account needed) -->
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />
    <meta name="twitter:image:alt" content={title} />
    
    <!-- Fonts are self-hosted via @fontsource (imported in the layout). No
         third-party font CDN, so no visitor IP is sent to Google. -->
    <style>
      /* Reduce CLS from font swap by sizing the fallback to match Archivo Black */
      @font-face { font-family: 'Archivo Black Fallback'; src: local('Arial Black'), local('Arial'); size-adjust: 95%; ascent-override: 100%; descent-override: 20%; }
    </style>
    
    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/images/hero-logo.png`} />

    <!-- PWA Manifest -->
    <link rel="manifest" href={`${base}/manifest.json`} />
    {heroImage && <link rel="preload" as="image" href={heroImage} />}
    
    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)} />
    {pathSegments.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}
    
    <title>{title}</title>
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Skip to main content. z-60 keeps it above the sticky header, which is
         z-50 and later in the DOM; at equal z-index the header would win the
         paint order and hide the link at the moment it receives focus. -->
    <a href="#main-content" class="absolute left-4 top-4 z-60 -translate-y-[200%] rounded bg-primary px-4 py-2 text-white shadow-lg transition-transform focus:translate-y-0">
      Skip to main content
    </a>
    <!-- Header -->
    <header class="bg-white backdrop-blur-xl border-b border-gray-200 shadow-sm sticky top-0 z-50 flex flex-col max-h-dvh" role="banner">
      <nav class="page-container py-3 shrink-0" aria-label="Main navigation">
        <div class="flex items-center justify-between">
          <a href={`${base}/`} class="flex items-center gap-3" aria-label={`${organization.name} - Home`} aria-current={navCurrent('/')}>
            <span class="text-xl md:text-2xl font-bold text-primary" style="font-family: 'Archivo Black', 'Archivo Black Fallback', serif;">
              {organization.abbreviation}
            </span>
            <span class="hidden sm:inline xl:hidden whitespace-nowrap text-sm font-semibold text-gray-600">
              Historical Model Railroad
            </span>
          </a>
          
          <!-- Desktop Nav -->
          <div class="hidden xl:flex items-center gap-5">
            {navItems.map((item) =>
              item.children ? (
                <details class="nav-more relative">
                  <summary data-current-section={item.children.some(child => navCurrent(child.href)) ? 'true' : undefined} class="nav-link nav-link-icon cursor-pointer list-none focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
                    {item.label}
                    <Icon name="solar:alt-arrow-down-linear" class="w-3.5 h-3.5 nav-more-chevron" />
                  </summary>
                  <ul class="nav-more-panel">
                    {item.children.map((child) => (
                      <li>
                        <a href={`${base}${child.href}`} aria-current={navCurrent(child.href)} class="nav-more-link">{child.label}</a>
                      </li>
                    ))}
                  </ul>
                </details>
              ) : item.cta ? (
                <a href={`${base}${item.href}`} aria-current={navCurrent(item.href)} class="btn-outline text-sm py-2 px-4 whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
                  {item.label}
                </a>
              ) : item.icon ? (
                <a href={`${base}${item.href}`} aria-current={navCurrent(item.href)} class="nav-link nav-link-icon whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
                  <Icon name={item.icon} class="w-4 h-4" />
                  {item.label}
                </a>
              ) : (
                <a href={`${base}${item.href}`} aria-current={navCurrent(item.href)} class="nav-link whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2">
                  {item.label}
                </a>
              )
            )}
          </div>
          
          <!-- Mobile Menu Button -->
          <button 
            id="mobile-menu-btn"
            class="xl:hidden p-3 text-gray-700 hover:text-primary focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 rounded-full"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
          >
            <Icon name="solar:hamburger-menu-linear" class="w-6 h-6" />
          </button>
        </div>
      </nav>
      
      <!-- Mobile Menu -->
      <nav 
        id="mobile-menu" 
        class="xl:hidden hidden min-h-0 overflow-y-auto overscroll-contain bg-white backdrop-blur-xl border-t border-gray-200 shadow-lg"
        aria-label="Mobile navigation"
      >
        <div class="page-container py-4 flex flex-col gap-2">
          {navItems.map((item) =>
            item.children ? (
              <div class="pt-2">
                <p class="px-4 pb-1 text-xs font-bold uppercase tracking-wider text-gray-500">{item.label}</p>
                {item.children.map((child) => (
                  <a href={`${base}${child.href}`} aria-current={navCurrent(child.href)} class="block py-3 px-4 text-gray-700 hover:bg-gray-50 hover:text-primary rounded-xl transition-colors">
                    {child.label}
                  </a>
                ))}
              </div>
            ) : item.cta ? (
              <a href={`${base}${item.href}`} aria-current={navCurrent(item.href)} class="btn-outline text-center rounded-full">
                {item.label}
              </a>
            ) : item.icon ? (
              <a href={`${base}${item.href}`} aria-current={navCurrent(item.href)} class="flex items-center gap-2 py-3 px-4 text-gray-700 hover:bg-gray-50 hover:text-primary rounded-xl transition-colors">
                <Icon name={item.icon} class="w-4 h-4" />
                {item.label}
              </a>
            ) : (
              <a href={`${base}${item.href}`} aria-current={navCurrent(item.href)} class="block py-3 px-4 text-gray-700 hover:bg-gray-50 hover:text-primary rounded-xl transition-colors">
                {item.label}
              </a>
            )
          )}
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="flex-grow" role="main">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-gray-900 text-white py-8" role="contentinfo">
      <div class="page-container">
        <div class="flex flex-col gap-4 md:flex-row md:justify-between md:gap-8">
          <div>
            <p class="font-bold">{organization.name}</p>
            <p class="text-sm text-gray-300 mt-1">{organization.location.venue}, {organization.location.city}</p>
            <p class="text-sm text-gray-300">
              {organization.nonprofit.classification} nonprofit.
              <a href={`${base}/donate#nonprofit-details`} class="inline-flex items-center min-h-11 underline hover:text-white">
                EIN: {organization.nonprofit.ein}
              </a>
            </p>
          </div>
          <div>
            <nav aria-label="Footer" class="flex flex-wrap gap-x-5 text-sm font-semibold md:justify-end">
              <a href={`${base}/events`} class="inline-flex items-center min-h-11 underline hover:text-gray-300">Announced openings</a>
              <a href={`${base}/contact`} class="inline-flex items-center min-h-11 underline hover:text-gray-300">Contact &amp; addresses</a>
              <a href={organization.location.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 underline hover:text-gray-300">Directions</a>
            </nav>
            <address class="flex flex-wrap gap-x-5 text-sm text-gray-300 not-italic md:justify-end">
              <a href={`mailto:${organization.contact.email}`} class="inline-flex items-center min-h-11 underline hover:text-white">{organization.contact.email}</a>
              <a href={organization.contact.phoneHref} class="inline-flex items-center min-h-11 underline hover:text-white">{organization.contact.phone}</a>
              <a href={organization.social.facebook} target="_blank" rel="noopener noreferrer" class="inline-flex items-center min-h-11 underline hover:text-white">Facebook</a>
            </address>
          </div>
        </div>

        <div class="border-t border-gray-800 mt-5 pt-4 text-xs text-gray-300">
          <p>Not affiliated with other museums or groups.</p>
          <div class="flex flex-wrap items-center justify-between gap-x-6 mt-2">
            <p>© {new Date().getFullYear()} {organization.name}.</p>
            <nav aria-label="Site policies" class="flex flex-wrap gap-x-4">
              <a href={`${base}/privacy`} class="inline-flex items-center min-h-11 underline hover:text-white">Privacy</a>
              <a href={`${base}/accessibility`} class="inline-flex items-center min-h-11 underline hover:text-white">Accessibility</a>
              <a href={`${base}${contentUse.path}`} class="inline-flex items-center min-h-11 underline hover:text-white">{contentUse.title}</a>
            </nav>
          </div>
        </div>
      </div>
    </footer>

    <!-- Cloudflare Web Analytics (cookie-free, no consent banner needed) -->
    {organization.analytics?.cfBeaconToken && (
      <script defer src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${organization.analytics.cfBeaconToken}"}`}
        is:inline />
    )}

    <!-- Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js');
      }
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<script>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  
  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', String(!isExpanded));
      mobileMenu.classList.toggle('hidden');
    });
    
    // Close menu when clicking a link
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });
    
    // Close menu on escape key
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !mobileMenu.classList.contains('hidden')) {
        mobileMenu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        menuBtn.focus();
      }
    });
  }

  // Desktop "More" disclosure. <details> handles the toggle and keyboard
  // operation on its own; these listeners only add the dismissal behavior a
  // navigation menu is expected to have.
  const navMore = document.querySelector<HTMLDetailsElement>('.nav-more');

  if (navMore) {
    document.addEventListener('click', (e) => {
      if (navMore.open && !navMore.contains(e.target as Node)) {
        navMore.open = false;
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && navMore.open) {
        navMore.open = false;
        navMore.querySelector('summary')?.focus();
      }
    });

    navMore.addEventListener('focusout', () => {
      // Runs after focus lands on the new target.
      requestAnimationFrame(() => {
        if (navMore.open && !navMore.contains(document.activeElement)) {
          navMore.open = false;
        }
      });
    });
  }
</script>
