---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCard from '../components/ContactCard.astro';
import { getCollection } from 'astro:content';
import { organization } from '../config/organization';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const volunteerPhotoIds = ['gallery-img-7238', 'gallery-img-7040', 'gallery-img-7041', 'gallery-img-9141'];
const galleryEntries = await getCollection('gallery');
const volunteerPhotos = volunteerPhotoIds.flatMap((id) => {
  const entry = galleryEntries.find((galleryEntry) => galleryEntry.id === id);
  return entry
    ? [{
        src: `${base}/images/${entry.data.image}`,
        alt: entry.data.title,
        caption: entry.data.caption,
      }]
    : [];
});

const volunteerEmailBody = [
  'Name:',
  'Interests (or not sure yet):',
  'Availability:',
].join('\n');
---

<BaseLayout title="Volunteer | N.C.N.G. Model Railroad" description="Volunteer with the N.C.N.G. Historical Model Railroad in Grass Valley. Help with operations, maintenance, scenery, photography, and visitor engagement.">
  <section class="bg-gray-900 text-white py-10 md:py-12">
    <div class="page-container max-w-3xl text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Become a Volunteer</h1>
      <p class="text-lg text-white/90">No model railroad experience needed.</p>
    </div>
  </section>

  <section class="py-10 md:py-12 bg-white">
    <div class="page-container max-w-3xl">
      <ContactCard
        heading="How to start"
        intro="Email your interests and availability to arrange your first work session."
        subject="Volunteer inquiry"
        body={volunteerEmailBody}
        cta="Email about volunteering"
        variant="plain"
        showDetails={false}
      />
      <p class="text-sm text-gray-600 mt-3">
        Or write to
        <a href={`mailto:${organization.contact.email}`} class="text-primary underline font-semibold">{organization.contact.email}</a>.
      </p>

      <section class="mt-8" aria-labelledby="ways-to-help-title">
        <h2 id="ways-to-help-title" class="text-2xl font-bold mb-3">Ways to help</h2>
        <ul class="list-disc pl-5 space-y-2 text-gray-600">
          <li>Operate trains, or welcome visitors and share railroad history as a docent.</li>
          <li>Build and maintain scenery, structures, and wiring.</li>
          <li>Help with research, photography, and documentation.</li>
        </ul>
      </section>

      <section class="mt-8" aria-labelledby="work-sessions-title">
        <h2 id="work-sessions-title" class="text-2xl font-bold mb-3">Work sessions</h2>
        <p class="text-gray-700 font-semibold mb-2">
          First Saturday and third Wednesday of the month, usually 11 AM to 2 PM.
        </p>
        <p class="text-gray-600">
          Email us before attending to confirm the session and entry arrangements.
          Work sessions are for volunteering, not public visits.
        </p>
        <a href={`${base}/events`} class="inline-flex items-center min-h-11 text-primary underline font-semibold">
          See announced public openings
        </a>
        <p class="text-gray-600 mt-4">
          <strong class="text-gray-900">Junior members (ages 12-18)</strong>
          are welcome with an accompanying adult member.
        </p>
        <p class="text-gray-600 mt-3">
          <strong class="text-gray-900">School visits:</strong>
          Teachers covering local or transportation history can
          <a href={`mailto:${organization.contact.email}?subject=School%20visit%20inquiry`} class="text-primary underline">email us</a>
          about bringing a class to a published public event.
        </p>
      </section>
    </div>

    <div class="page-container max-w-4xl mt-10">
      <h2 class="text-2xl font-bold mb-5">Volunteers at work</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {volunteerPhotos.map((photo, index) => (
          <figure class={`overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm ${index === 0 ? 'sm:col-span-2' : ''}`}>
            <img
              src={photo.src}
              alt={photo.alt}
              class={`w-full object-cover ${index === 0 ? 'aspect-[16/9]' : 'aspect-[4/3]'}`}
              loading="lazy"
              decoding="async"
              width={index === 0 ? 1200 : 800}
              height={index === 0 ? 675 : 600}
            />
            <figcaption class="px-4 py-3 text-sm text-gray-600">
              {photo.caption}
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
